; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="g13"
run/main_scene="uid://d0wp6ks55ba57"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://ckuuaixkcvbn0"

[audio]

general/text_to_speech=true

[autoload]

arc="*uid://dxrtg0402d5yq"
arc_event="*uid://ktuxtypcm7sr"
SceneManager="*uid://j20v4cg7v8m1"

[display]

window/size/mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[editor]

naming/node_name_casing=2
naming/script_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gd-blender-3d-shortcuts/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/ridiculous_coding/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://code/": "orange",
"res://pics/": "green",
"res://prefabs/": "purple",
"res://resources/": "red",
"res://resources/materials/": "blue",
