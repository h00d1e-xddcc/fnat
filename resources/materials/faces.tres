[gd_resource type="ShaderMaterial" format=3 uid="uid://b6boaj66aw4og"]

[ext_resource type="Texture2D" uid="uid://6u405pomfaan" path="res://prefabs/misc/faces.png" id="1_wpce0"]

[sub_resource type="Shader" id="Shader_wpce0"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.2.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, diffuse_burley, specular_schlick_ggx, cull_disabled;

instance uniform vec4 f_coloring : source_color = vec4(1.0, 1.0, 1.0, 1.0);
instance uniform vec2 uv_off = vec2(0, -0.375);
instance uniform float f_tint : hint_range(0.0, 1.0) = 1;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_nearest, repeat_disable;
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_nearest, repeat_disable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_nearest, repeat_disable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
	vec4 albedo_tex = texture(texture_albedo, UV + uv_off);
	vec2 base_uv = UV;

	ALBEDO = albedo.rgb * albedo_tex.rgb;
	float mask = step(f_tint, ALBEDO.r);
	ALBEDO *= mix(albedo.rgb, f_coloring.rgb, mask);
	ALPHA *= albedo.a * albedo_tex.a;
}
"

[resource]
resource_name = "faces"
render_priority = 0
shader = SubResource("Shader_wpce0")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/texture_albedo = ExtResource("1_wpce0")
shader_parameter/albedo_texture_size = Vector2i(1024, 1024)
shader_parameter/point_size = 1.0
shader_parameter/roughness = 1.0
shader_parameter/metallic_texture_channel = Vector4(1, 0, 0, 0)
shader_parameter/specular = 0.5
shader_parameter/metallic = 0.0
shader_parameter/uv1_scale = Vector3(1, 1, 1)
shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/uv2_scale = Vector3(1, 1, 1)
shader_parameter/uv2_offset = Vector3(0, 0, 0)
