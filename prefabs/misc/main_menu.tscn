[node name="text" type="Label" parent="ui/disclaimer_back" unique_id=386683077]
layout_mode = 0
offset_left = 102.0
offset_top = 122.0
offset_right = 3690.0
offset_bottom = 379.0
text = "Сие произведение находится на стадии разработки, \\n
и содержит критические сложности, \\n
что могут повлиять на игровой опыт. \\n
Не рекомендуется играть никому\\n

Имеются резкие вспышки, скримеры, и бла бла бла.\\n
\\n
Все события, организации и люди\\n
не являются вымышлеными, все\\n
основанно на реальных событиях. \\n
И детей реально не вывозили с Бамбаса.\\n
\\n
Возможно используется контент других авторов, \\n
можете поплакать об этом.\\n
\\n
Зачем я пишу этот текст? \\n
Пойду лучше паунс в окно оформлю\\n"
label_settings = SubResource("LabelSettings_2cuxt")

[node name="ps" type="Label" parent="ui/disclaimer_back" unique_id=1755293788]
layout_mode = 0
offset_left = 146.0
offset_top = 474.0
offset_right = 3734.0
offset_bottom = 731.0
text = "P.S. Для лучшего игрового опыта, \\n
дождись ночи, выключи свет, \\n
используй наушники, и закрой свою дверь\\n"
label_settings = SubResource("LabelSettings_4dys7")

